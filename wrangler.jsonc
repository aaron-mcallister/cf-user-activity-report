{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-user-activity-report",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // ---------------------------------------------------------------------------
  // Custom domain (optional). Deploy from an account where the zone exists, e.g.:
  //   "routes": [
  //     { "pattern": "activity.example.com", "custom_domain": true }
  //   ],
  // A public instance should run DEMO_MODE=on (synthetic data — safe to expose, no
  // PII, no auth needed). Use a separate, Access-protected deploy for real account
  // data. See docs/deploy.md.
  // ---------------------------------------------------------------------------

  // LIVE instances (real data): once a custom domain is attached, also set
  //   "workers_dev": false, "preview_urls": false
  // so the only way in is the Access-protected hostname. (Leave both on for demo-only deploys.)

  // Observability is OFF by default: request logs include URLs, and the /user/<email>
  // route puts user emails (PII) in them. Enable only if you accept that in your logs.
  "observability": {
    "enabled": false
  },
  "vars": {
    // Your Cloudflare Account ID (Dash -> any domain -> Overview, right rail).
    // Can be left blank to auto-discover from the token (if it sees one account).
    "CF_ACCOUNT_ID": "",

    // Optional: a Zone ID to include origin HTTP + WAF/firewall events in the report.
    "CF_ZONE_ID": "",

    // "auto" = demo data when no CF_API_TOKEN is set, live data when it is.
    // Force with "on" (always demo) or "off" (always live).
    "DEMO_MODE": "auto",

    // Safety valve: serving REAL user activity (PII) requires auth to be configured
    // (Cloudflare Access + the two CF_ACCESS_* vars below, or Basic Auth secrets).
    // "true" only takes effect on a localhost request (local dev); it is ignored when deployed.
    "ALLOW_UNAUTHENTICATED": "false",

    // REQUIRED to use Cloudflare Access for live data: the app verifies the signed Access
    // JWT (a bare header is never trusted), so even an exposed route (e.g. a still-enabled
    // *.workers.dev URL) can't be spoofed. AUD = your Access application's "Application
    // Audience (AUD) Tag"; team domain = your Zero Trust team domain. See docs/deploy.md.
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": ""

    // Optional built-in Basic Auth for the deployed app. Prefer Cloudflare Access.
    // Set these as SECRETS, not vars:  npx wrangler secret put BASIC_AUTH_USER
    //                                  npx wrangler secret put BASIC_AUTH_PASS
  }

  // ---------------------------------------------------------------------------
  // OPTIONAL retention (off by default — the default deploy is stateless & zero-config).
  // Still free up to 10 GB in R2. Enable R2 on your account once, create the bucket
  // (`wrangler r2 bucket create user-activity-history`), then uncomment the block below
  // to have a Cron trigger snapshot each pull into R2 as NDJSON, keeping history beyond
  // the platform's short analytics window. See docs/deploy.md#retention.
  //
  // "r2_buckets": [
  //   { "binding": "ACTIVITY_BUCKET", "bucket_name": "user-activity-history" }
  // ],
  // "triggers": {
  //   "crons": ["0 * * * *"]   // hourly
  // }
  // ---------------------------------------------------------------------------
}
