# Easiest way to create your .dev.vars: run `npm run setup` and paste your token.
# This file is the by-hand alternative — copy it to `.dev.vars` for local dev (`npm run dev`).
# `.dev.vars` is gitignored — NEVER commit a real token.
#
# Create a scoped, read-only API token at:
#   https://dash.cloudflare.com/profile/api-tokens  -> Create Custom Token
# Permissions:
#   - Account > Account Analytics > Read        (Gateway / Zero Trust datasets)
#   - Account > Access: Audit Logs > Read       (Access authentication logs)
#   - Zone    > Analytics > Read                (optional: origin HTTP + WAF events)
# Scope it to the single account (and zone) you are reporting on. Short expiry is fine.

CF_API_TOKEN="paste-your-scoped-read-only-token-here"

# Optional overrides (otherwise taken from wrangler.jsonc [vars] or auto-discovered):
# CF_ACCOUNT_ID="your-account-id"
# CF_ZONE_ID="your-zone-id"

# Optional built-in Basic Auth for local testing of the auth guard:
# BASIC_AUTH_USER="admin"
# BASIC_AUTH_PASS="change-me"
